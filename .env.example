NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://chave:chave_secret@localhost:5432/chave_auth?schema=public

JWT_SECRET=replace-this-development-secret-with-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
PASSWORD_RESET_TOKEN_TTL=30m

REFRESH_COOKIE_NAME=chave_refresh
REFRESH_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:4001
FRONTEND_RESET_PASSWORD_URL=http://localhost:4001/reset-password

SEED_ADMIN_EMAIL=admin@chave.local
SEED_ADMIN_PASSWORD=Admin123!
